{
  "name": "somali-hotel-erp-backend",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "node scripts/seed-accounting.mjs"
  },
  "description": "Focused Hotel ERP backend for small and medium hotels in Somalia",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"docs/**/*.md\" \"*.{json,md,yml,yaml}\" && prisma format",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"docs/**/*.md\" \"*.{json,md,yml,yaml}\" && prisma format --check",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest --config test/jest-unit.json --runInBand",
    "test:watch": "jest --config test/jest-unit.json --watch",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "accounting:verify-db": "node scripts/verify-accounting-foundation.mjs",
    "db:studio": "prisma studio",
    "bootstrap:admin": "tsx src/bootstrap/bootstrap-admin.ts",
    "demo:reset": "node scripts/demo-reset.mjs --confirm=RESET_DEMO_DATA",
    "demo:accounting": "node scripts/demo-accounting-workflow.mjs",
    "seed:accounting": "node scripts/seed-accounting.mjs",
    "seed:accounting:valid": "node scripts/seed-accounting-valid-api.mjs",
    "seed:accounting:operational": "node scripts/seed-accounting-operational.mjs",
    "seed:realistic": "node scripts/seed-realistic.mjs",
    "seed:accounting:3y": "node scripts/seed-accounting-three-years.mjs",
    "seed:accounting:full": "node scripts/seed-accounting-full.mjs",
    "seed:large-safe": "node scripts/seed-large-safe.mjs",
    "load:smoke": "node scripts/load-smoke.mjs",
    "backup": "powershell -NoProfile -File scripts/backup.ps1",
    "restore:drill": "powershell -NoProfile -File scripts/restore-drill.ps1",
    "db:roles:production": "powershell -NoProfile -File scripts/configure-production-db-roles.ps1",
    "postman:generate": "node postman/generate-collection.mjs"
  },
  "dependencies": {
    "@keyv/redis": "^5.1.6",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.45.1",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "helmet": "^8.1.0",
    "nestjs-pino": "^4.4.1",
    "pg": "^8.16.3",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "jest": "^30.5.0",
    "prettier": "^3.6.2",
    "prisma": "^7.9.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1",
    "@nestjs/swagger": {
      "js-yaml": "^5.3.0"
    }
  }
}
