generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum RoomStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  DIRTY
  CLEANING
  MAINTENANCE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum ChargeType {
  ROOM
  SERVICE
  DISCOUNT
  OTHER
}

enum PaymentKind {
  PAYMENT
  REFUND
}

enum PaymentStatus {
  COMPLETED
  VOIDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_PAID
  VOIDED
}

enum HousekeepingStatus {
  DIRTY
  CLEANING
  COMPLETED
}

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  VERIFIED
  CLOSED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  PAID
  REJECTED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum AccountingJournalType {
  GENERAL
  SALES
  CASH
  BANK
  MOBILE_MONEY
  PURCHASE
  ADJUSTMENT
  NIGHT_AUDIT
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED
}

model Hotel {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String               @unique @db.VarChar(32)
  name                String               @db.VarChar(160)
  phone               String?              @db.VarChar(32)
  email               String?              @db.VarChar(254)
  address             String?
  currencyCode        String               @default("USD") @db.Char(3)
  timezone            String               @default("Africa/Mogadishu") @db.VarChar(64)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  users               User[]
  roles               Role[]
  floors              Floor[]
  roomTypes           RoomType[]
  rooms               Room[]
  guests              Guest[]
  reservations        Reservation[]
  services            Service[]
  paymentMethods      PaymentMethod[]
  payments            Payment[]
  invoices            Invoice[]
  expenseCategories   ExpenseCategory[]
  expenses            Expense[]
  housekeepingTasks   HousekeepingTask[]
  maintenanceRequests MaintenanceRequest[]
  auditLogs           AuditLog[]
  accounts            Account[]
  accountingJournals  AccountingJournal[]
  journalEntries      JournalEntry[]
  accountingSettings  AccountingSettings?
  accountingSequences AccountingSequence[]
  fiscalPeriods       FiscalPeriod[]
}

model User {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId                String               @db.Uuid
  email                  String               @unique @db.VarChar(254)
  username               String               @unique @db.VarChar(64)
  passwordHash           String               @db.VarChar(255)
  fullName               String               @db.VarChar(160)
  status                 UserStatus           @default(ACTIVE)
  failedLoginAttempts    Int                  @default(0)
  lockedUntil            DateTime?            @db.Timestamptz(3)
  lastLoginAt            DateTime?            @db.Timestamptz(3)
  deletedAt              DateTime?            @db.Timestamptz(3)
  createdAt              DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime             @updatedAt @db.Timestamptz(3)
  hotel                  Hotel                @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  roles                  UserRole[]
  authSessions           AuthSession[]
  createdExpenses        Expense[]
  approvedExpenses       Expense[]            @relation("ExpenseApprover")
  paidExpenses           Expense[]            @relation("ExpensePayer")
  rejectedExpenses       Expense[]            @relation("ExpenseRejecter")
  assignedHousekeeping   HousekeepingTask[]   @relation("HousekeepingAssignee")
  assignedMaintenance    MaintenanceRequest[] @relation("MaintenanceAssignee")
  createdMaintenance     MaintenanceRequest[] @relation("MaintenanceCreator")
  completedMaintenance   MaintenanceRequest[] @relation("MaintenanceCompleter")
  verifiedMaintenance    MaintenanceRequest[] @relation("MaintenanceVerifier")
  closedMaintenance      MaintenanceRequest[] @relation("MaintenanceCloser")
  cancelledMaintenance   MaintenanceRequest[] @relation("MaintenanceCanceller")
  reservationEvents      ReservationHistory[]
  createdPayments        Payment[]            @relation("PaymentCreator")
  voidedCharges          Charge[]             @relation("ChargeVoider")
  issuedInvoices         Invoice[]            @relation("InvoiceIssuer")
  voidedInvoices         Invoice[]            @relation("InvoiceVoider")
  reversedExpenses       Expense[]            @relation("ExpenseReverser")
  auditLogs              AuditLog[]
  createdJournalEntries  JournalEntry[]       @relation("JournalEntryCreator")
  postedJournalEntries   JournalEntry[]       @relation("JournalEntryPoster")
  reversedJournalEntries JournalEntry[]       @relation("JournalEntryReverser")

  @@index([hotelId, status])
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId     String           @db.Uuid
  name        String           @db.VarChar(64)
  description String?
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  deletedAt   DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  hotel       Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([hotelId, name])
  @@index([hotelId, isActive])
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique @db.VarChar(96)
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now()) @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AuthSession {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String         @db.Uuid
  expiresAt     DateTime       @db.Timestamptz(3)
  revokedAt     DateTime?      @db.Timestamptz(3)
  revokeReason  String?        @db.VarChar(160)
  createdByIp   String?        @db.Inet
  userAgent     String?        @db.VarChar(512)
  lastSeenAt    DateTime       @default(now()) @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model RefreshToken {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId       String         @db.Uuid
  tokenHash       String         @unique @db.Char(64)
  expiresAt       DateTime       @db.Timestamptz(3)
  usedAt          DateTime?      @db.Timestamptz(3)
  revokedAt       DateTime?      @db.Timestamptz(3)
  replacedBy      String?        @db.Uuid
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  session         AuthSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedByToken RefreshToken?  @relation("TokenReplacement", fields: [replacedBy], references: [id], onDelete: SetNull)
  replaces        RefreshToken[] @relation("TokenReplacement")

  @@index([sessionId, expiresAt])
  @@index([expiresAt])
}

model Floor {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId   String   @db.Uuid
  number    Int
  name      String?  @db.VarChar(80)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rooms     Room[]

  @@unique([hotelId, number])
}

model RoomType {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId          String   @db.Uuid
  code             String   @db.VarChar(32)
  name             String   @db.VarChar(100)
  description      String?
  capacityAdults   Int
  capacityChildren Int      @default(0)
  basePrice        Decimal  @db.Decimal(14, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
  hotel            Hotel    @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  rooms            Room[]

  @@unique([hotelId, code])
  @@unique([hotelId, name])
  @@index([hotelId, isActive])
}

model Room {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId             String               @db.Uuid
  floorId             String?              @db.Uuid
  roomTypeId          String               @db.Uuid
  roomNumber          String               @db.VarChar(32)
  status              RoomStatus           @default(AVAILABLE)
  notes               String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  hotel               Hotel                @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  floor               Floor?               @relation(fields: [floorId], references: [id], onDelete: Restrict)
  roomType            RoomType             @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  reservationRooms    ReservationRoom[]
  housekeepingTasks   HousekeepingTask[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([hotelId, roomNumber])
  @@index([hotelId, status, isActive])
  @@index([hotelId, roomTypeId, status])
  @@index([floorId])
}

model Guest {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId         String        @db.Uuid
  fullName        String        @db.VarChar(160)
  phone           String?       @db.VarChar(32)
  normalizedPhone String?       @db.VarChar(32)
  email           String?       @db.VarChar(254)
  normalizedEmail String?       @db.VarChar(254)
  passportNumber  String?       @db.VarChar(64)
  nationalId      String?       @db.VarChar(64)
  nationality     String?       @db.VarChar(80)
  address         String?
  notes           String?
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  hotel           Hotel         @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  reservations    Reservation[]
  payments        Payment[]

  @@index([hotelId, fullName])
  @@index([hotelId, createdAt])
}

model Reservation {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId           String               @db.Uuid
  guestId           String               @db.Uuid
  bookingNumber     String               @db.VarChar(40)
  status            ReservationStatus    @default(PENDING)
  checkInDate       DateTime             @db.Date
  checkOutDate      DateTime             @db.Date
  adults            Int                  @default(1)
  children          Int                  @default(0)
  discountAmount    Decimal              @default(0) @db.Decimal(14, 2)
  notes             String?
  cancelledAt       DateTime?            @db.Timestamptz(3)
  cancellationNote  String?
  checkedInAt       DateTime?            @db.Timestamptz(3)
  checkedOutAt      DateTime?            @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(3)
  hotel             Hotel                @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  guest             Guest                @relation(fields: [guestId], references: [id], onDelete: Restrict)
  rooms             ReservationRoom[]
  history           ReservationHistory[]
  charges           Charge[]
  payments          Payment[]
  invoice           Invoice?
  housekeepingTasks HousekeepingTask[]

  @@unique([hotelId, bookingNumber])
  @@index([hotelId, status, checkInDate])
  @@index([hotelId, status, checkOutDate])
  @@index([guestId, createdAt])
}

model ReservationRoom {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationId String            @db.Uuid
  roomId        String            @db.Uuid
  checkInDate   DateTime          @db.Date
  checkOutDate  DateTime          @db.Date
  nightlyRate   Decimal           @db.Decimal(14, 2)
  bookingStatus ReservationStatus @default(PENDING)
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)
  reservation   Reservation       @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  room          Room              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  roomCharge    Charge?
  roomNights    ReservationRoomNight[]

  @@unique([reservationId, roomId])
  @@index([roomId, checkInDate, checkOutDate])
  @@index([reservationId])
}

model ReservationRoomNight {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId           String   @db.Uuid
  reservationRoomId String   @db.Uuid
  businessDate      DateTime @db.Date
  nightlyRate       Decimal  @db.Decimal(14, 2)
  amount            Decimal  @db.Decimal(14, 2)
  status            String   @default("POSTED") @db.VarChar(32)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
  reservationRoom   ReservationRoom @relation(fields: [reservationRoomId], references: [id], onDelete: Restrict)

  @@unique([hotelId, reservationRoomId, businessDate])
  @@index([hotelId, businessDate, status])
  @@index([reservationRoomId, businessDate])
}

model HotelBusinessDate {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId          String   @db.Uuid
  businessDate     DateTime @db.Date
  status           String   @default("OPEN") @db.VarChar(32)
  roomNights       Int      @default(0)
  totalRoomRevenue Decimal  @default(0) @db.Decimal(14, 2)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  @@unique([hotelId, businessDate])
  @@index([hotelId, businessDate, status])
}

model ReservationHistory {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationId String             @db.Uuid
  fromStatus    ReservationStatus?
  toStatus      ReservationStatus
  note          String?
  changedById   String?            @db.Uuid
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  reservation   Reservation        @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  changedBy     User?              @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([reservationId, createdAt])
}

model Service {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId          String   @db.Uuid
  name             String   @db.VarChar(120)
  description      String?
  defaultPrice     Decimal  @db.Decimal(14, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
  revenueAccountId String?  @db.Uuid
  hotel            Hotel    @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  revenueAccount   Account? @relation(fields: [revenueAccountId], references: [id], onDelete: Restrict)
  charges          Charge[]

  @@unique([hotelId, name])
  @@index([hotelId, isActive])
  @@index([revenueAccountId])
}

model Charge {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationId     String           @db.Uuid
  reservationRoomId String?          @unique @db.Uuid
  serviceId         String?          @db.Uuid
  type              ChargeType
  description       String           @db.VarChar(255)
  quantity          Decimal          @default(1) @db.Decimal(10, 2)
  unitPrice         Decimal          @db.Decimal(14, 2)
  totalAmount       Decimal          @db.Decimal(14, 2)
  chargeDate        DateTime         @default(now()) @db.Timestamptz(3)
  voidedAt          DateTime?        @db.Timestamptz(3)
  voidedById        String?          @db.Uuid
  voidReason        String?          @db.VarChar(500)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  reservation       Reservation      @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  reservationRoom   ReservationRoom? @relation(fields: [reservationRoomId], references: [id], onDelete: Restrict)
  service           Service?         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  voidedBy          User?            @relation("ChargeVoider", fields: [voidedById], references: [id], onDelete: Restrict)
  invoiceItems      InvoiceItem[]

  @@index([reservationId, chargeDate])
  @@index([serviceId])
  @@index([voidedById])
}

model PaymentMethod {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId         String    @db.Uuid
  name            String    @db.VarChar(80)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  ledgerAccountId String?   @db.Uuid
  hotel           Hotel     @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  ledgerAccount   Account?  @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  payments        Payment[]
  expenses        Expense[]

  @@unique([hotelId, name])
  @@index([hotelId, isActive])
  @@index([ledgerAccountId])
}

model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId           String        @db.Uuid
  reservationId     String?       @db.Uuid
  invoiceId         String?       @db.Uuid
  guestId           String?       @db.Uuid
  paymentMethodId   String        @db.Uuid
  createdById       String        @db.Uuid
  requestKey        String        @db.Uuid
  kind              PaymentKind   @default(PAYMENT)
  status            PaymentStatus @default(COMPLETED)
  amount            Decimal       @db.Decimal(14, 2)
  reference         String?       @db.VarChar(120)
  note              String?
  originalPaymentId String?       @db.Uuid
  paidAt            DateTime      @default(now()) @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  hotel             Hotel         @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  reservation       Reservation?  @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  invoice           Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  guest             Guest?        @relation(fields: [guestId], references: [id], onDelete: Restrict)
  paymentMethod     PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  createdBy         User          @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  originalPayment   Payment?      @relation("PaymentRefunds", fields: [originalPaymentId], references: [id], onDelete: Restrict)
  refunds           Payment[]     @relation("PaymentRefunds")

  @@unique([hotelId, requestKey])
  @@index([hotelId, paidAt])
  @@index([reservationId, paidAt])
  @@index([invoiceId])
  @@index([guestId])
  @@index([originalPaymentId])
}

model Invoice {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId        String        @db.Uuid
  reservationId  String        @unique @db.Uuid
  invoiceNumber  String        @db.VarChar(40)
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @default(0) @db.Decimal(14, 2)
  discountAmount Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal       @default(0) @db.Decimal(14, 2)
  issuedAt       DateTime?     @db.Timestamptz(3)
  issuedById     String?       @db.Uuid
  voidedAt       DateTime?     @db.Timestamptz(3)
  voidedById     String?       @db.Uuid
  voidReason     String?       @db.VarChar(500)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  hotel          Hotel         @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  reservation    Reservation   @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  items          InvoiceItem[]
  payments       Payment[]
  issuedBy       User?         @relation("InvoiceIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  voidedBy       User?         @relation("InvoiceVoider", fields: [voidedById], references: [id], onDelete: Restrict)

  @@unique([hotelId, invoiceNumber])
  @@index([hotelId, status, issuedAt])
  @@index([issuedById])
  @@index([voidedById])
}

model InvoiceItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId   String   @db.Uuid
  chargeId    String?  @unique @db.Uuid
  description String   @db.VarChar(255)
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(14, 2)
  amount      Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  charge      Charge?  @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([chargeId])
}

model ExpenseCategory {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId          String    @db.Uuid
  name             String    @db.VarChar(100)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  expenseAccountId String?   @db.Uuid
  hotel            Hotel     @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  expenseAccount   Account?  @relation(fields: [expenseAccountId], references: [id], onDelete: Restrict)
  expenses         Expense[]

  @@unique([hotelId, name])
  @@index([hotelId, isActive])
  @@index([expenseAccountId])
}

model Expense {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId         String          @db.Uuid
  categoryId      String          @db.Uuid
  paymentMethodId String?         @db.Uuid
  createdById     String          @db.Uuid
  requestKey      String          @db.Uuid
  status          ExpenseStatus   @default(DRAFT)
  amount          Decimal         @db.Decimal(14, 2)
  expenseDate     DateTime        @db.Date
  description     String          @db.VarChar(255)
  reference       String?         @db.VarChar(120)
  invoiceNumber   String?         @db.VarChar(120)
  dueDate         DateTime?       @db.Date
  submittedAt     DateTime?       @db.Timestamptz(3)
  approvedAt      DateTime?       @db.Timestamptz(3)
  approvedById    String?         @db.Uuid
  paidAt          DateTime?       @db.Timestamptz(3)
  paidById        String?         @db.Uuid
  rejectedAt      DateTime?       @db.Timestamptz(3)
  rejectedById    String?         @db.Uuid
  rejectionReason String?         @db.VarChar(500)
  reversalReason  String?
  reversedAt      DateTime?       @db.Timestamptz(3)
  reversedById    String?         @db.Uuid
  maintenanceId   String?         @unique @db.Uuid
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  hotel           Hotel           @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  category        ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  paymentMethod   PaymentMethod?  @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  createdBy       User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy      User?           @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  paidBy          User?           @relation("ExpensePayer", fields: [paidById], references: [id], onDelete: Restrict)
  rejectedBy      User?           @relation("ExpenseRejecter", fields: [rejectedById], references: [id], onDelete: Restrict)
  reversedBy      User?           @relation("ExpenseReverser", fields: [reversedById], references: [id], onDelete: Restrict)
  maintenance     MaintenanceRequest? @relation("MaintenanceExpense", fields: [maintenanceId], references: [id], onDelete: SetNull)

  @@unique([hotelId, requestKey])
  @@index([hotelId, status, expenseDate])
  @@index([hotelId, expenseDate])
  @@index([categoryId, expenseDate])
  @@index([paymentMethodId])
  @@index([createdById])
  @@index([approvedById])
  @@index([paidById])
  @@index([reversedById])
}

model HousekeepingTask {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId       String             @db.Uuid
  roomId        String             @db.Uuid
  reservationId String?            @db.Uuid
  assignedToId  String?            @db.Uuid
  status        HousekeepingStatus @default(DIRTY)
  notes         String?
  startedAt     DateTime?          @db.Timestamptz(3)
  completedAt   DateTime?          @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)
  hotel         Hotel              @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  room          Room               @relation(fields: [roomId], references: [id], onDelete: Restrict)
  reservation   Reservation?       @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  assignedTo    User?              @relation("HousekeepingAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@unique([reservationId, roomId])
  @@index([hotelId, status, createdAt])
  @@index([roomId, status])
  @@index([assignedToId, status])
}

model MaintenanceRequest {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId            String              @db.Uuid
  roomId             String              @db.Uuid
  assignedToId       String?             @db.Uuid
  createdById        String?             @db.Uuid
  problem            String
  category           String?             @db.VarChar(100)
  priority           MaintenancePriority @default(MEDIUM)
  status             MaintenanceStatus   @default(OPEN)
  cost               Decimal?            @db.Decimal(14, 2)
  notes              String?
  assignedAt         DateTime?           @db.Timestamptz(3)
  startedAt          DateTime?           @db.Timestamptz(3)
  heldAt             DateTime?           @db.Timestamptz(3)
  resumedAt          DateTime?           @db.Timestamptz(3)
  completedAt        DateTime?           @db.Timestamptz(3)
  completedById      String?             @db.Uuid
  verifiedAt         DateTime?           @db.Timestamptz(3)
  verifiedById       String?             @db.Uuid
  closedAt           DateTime?           @db.Timestamptz(3)
  closedById         String?             @db.Uuid
  cancelledAt        DateTime?           @db.Timestamptz(3)
  cancelledById      String?             @db.Uuid
  cancelReason       String?             @db.VarChar(500)
  previousRoomStatus RoomStatus?
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  hotel              Hotel               @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  room               Room                @relation(fields: [roomId], references: [id], onDelete: Restrict)
  assignedTo         User?               @relation("MaintenanceAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy          User?               @relation("MaintenanceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  completedBy        User?               @relation("MaintenanceCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  verifiedBy         User?               @relation("MaintenanceVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  closedBy           User?               @relation("MaintenanceCloser", fields: [closedById], references: [id], onDelete: SetNull)
  cancelledBy        User?               @relation("MaintenanceCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  expense            Expense?            @relation("MaintenanceExpense")

  @@index([hotelId, status, createdAt])
  @@index([roomId, status])
  @@index([assignedToId, status])
  @@index([createdById])
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId    String   @db.Uuid
  userId     String?  @db.Uuid
  action     String   @db.VarChar(96)
  entityType String   @db.VarChar(80)
  entityId   String   @db.Uuid
  oldValue   Json?
  newValue   Json?
  ipAddress  String?  @db.Inet
  userAgent  String?  @db.VarChar(512)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  hotel      Hotel    @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([hotelId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
}

model Account {
  id                      String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId                 String               @db.Uuid
  code                    String               @db.VarChar(32)
  name                    String               @db.VarChar(160)
  type                    AccountType
  subType                 String?              @db.VarChar(64)
  normalBalance           NormalBalance
  parentAccountId         String?              @db.Uuid
  currency                String               @db.Char(3)
  isActive                Boolean              @default(true)
  allowManualPosting      Boolean              @default(true)
  createdAt               DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime             @updatedAt @db.Timestamptz(3)
  hotel                   Hotel                @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  parent                  Account?             @relation("AccountHierarchy", fields: [parentAccountId], references: [id], onDelete: Restrict)
  children                Account[]            @relation("AccountHierarchy")
  journalLines            JournalLine[]
  paymentMethods          PaymentMethod[]
  services                Service[]
  expenseCategories       ExpenseCategory[]
  settingsRoomRevenue     AccountingSettings[] @relation("SettingsRoomRevenue")
  settingsGuestReceivable AccountingSettings[] @relation("SettingsGuestReceivable")
  settingsCash            AccountingSettings[] @relation("SettingsCash")
  settingsBank            AccountingSettings[] @relation("SettingsBank")
  settingsMobileMoney     AccountingSettings[] @relation("SettingsMobileMoney")
  settingsDeposit         AccountingSettings[] @relation("SettingsDeposit")
  settingsTaxPayable      AccountingSettings[] @relation("SettingsTaxPayable")
  settingsServiceRevenue  AccountingSettings[] @relation("SettingsServiceRevenue")
  settingsDiscount        AccountingSettings[] @relation("SettingsDiscount")
  settingsExpense         AccountingSettings[] @relation("SettingsExpense")
  settingsAccountsPayable AccountingSettings[] @relation("SettingsAccountsPayable")

  @@unique([hotelId, code])
  @@index([hotelId, type, isActive])
  @@index([parentAccountId])
}

model AccountingJournal {
  id        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId   String                @db.Uuid
  code      String                @db.VarChar(24)
  name      String                @db.VarChar(120)
  type      AccountingJournalType
  isActive  Boolean               @default(true)
  createdAt DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt DateTime              @updatedAt @db.Timestamptz(3)
  hotel     Hotel                 @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  entries   JournalEntry[]

  @@unique([hotelId, code])
  @@index([hotelId, type, isActive])
}

model FiscalPeriod {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId   String             @db.Uuid
  name      String             @db.VarChar(160)
  startDate DateTime           @db.Date
  endDate   DateTime           @db.Date
  status    FiscalPeriodStatus @default(OPEN)
  isOpening Boolean            @default(false)
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @db.Timestamptz(3)
  hotel     Hotel              @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  entries   JournalEntry[]

  @@unique([hotelId, name])
  @@index([hotelId, startDate, endDate])
  @@index([hotelId, startDate, status])
}

model JournalEntry {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId          String             @db.Uuid
  journalId        String             @db.Uuid
  entryNumber      String             @db.VarChar(40)
  businessDate     DateTime           @db.Date
  postingDate      DateTime           @db.Timestamptz(3)
  sourceType       String             @db.VarChar(64)
  sourceId         String?            @db.Uuid
  reference        String?            @db.VarChar(120)
  description      String             @db.VarChar(255)
  status           JournalEntryStatus @default(DRAFT)
  fiscalPeriodId   String?            @db.Uuid
  createdById      String             @db.Uuid
  postedById       String?            @db.Uuid
  postedAt         DateTime?          @db.Timestamptz(3)
  reversedEntryId  String?            @unique @db.Uuid
  reversalEntryId  String?            @unique @db.Uuid
  reversalReason   String?            @db.VarChar(500)
  reversedById     String?            @db.Uuid
  reversedAt       DateTime?          @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)
  hotel            Hotel              @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  journal          AccountingJournal  @relation(fields: [journalId], references: [id], onDelete: Restrict)
  fiscalPeriod     FiscalPeriod?      @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  createdBy        User               @relation("JournalEntryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy         User?              @relation("JournalEntryPoster", fields: [postedById], references: [id], onDelete: Restrict)
  reversedBy       User?              @relation("JournalEntryReverser", fields: [reversedById], references: [id], onDelete: Restrict)
  reversedEntry    JournalEntry?      @relation("ReversalToOriginal", fields: [reversedEntryId], references: [id], onDelete: Restrict)
  reversalOf       JournalEntry?      @relation("ReversalToOriginal")
  reversalEntry    JournalEntry?      @relation("OriginalToReversal", fields: [reversalEntryId], references: [id], onDelete: Restrict)
  reversedOriginal JournalEntry?      @relation("OriginalToReversal")
  lines            JournalLine[]

  @@unique([hotelId, entryNumber])
  @@unique([hotelId, sourceType, sourceId])
  @@index([hotelId, businessDate, status])
  @@index([hotelId, journalId, postingDate])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journalEntryId String       @db.Uuid
  accountId      String       @db.Uuid
  description    String?      @db.VarChar(255)
  debit          Decimal      @default(0) @db.Decimal(19, 4)
  credit         Decimal      @default(0) @db.Decimal(19, 4)
  currency       String       @db.Char(3)
  exchangeRate   Decimal      @default(1) @db.Decimal(19, 8)
  sourceType     String?      @db.VarChar(64)
  sourceId       String?      @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId, journalEntryId])
  @@index([sourceType, sourceId])
}

model AccountingSettings {
  id                              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId                         String   @unique @db.Uuid
  defaultRoomRevenueAccountId     String   @db.Uuid
  defaultGuestReceivableAccountId String   @db.Uuid
  defaultCashAccountId            String   @db.Uuid
  defaultBankAccountId            String   @db.Uuid
  defaultMobileMoneyAccountId     String   @db.Uuid
  defaultDepositAccountId         String   @db.Uuid
  defaultTaxPayableAccountId      String   @db.Uuid
  defaultServiceRevenueAccountId  String   @db.Uuid
  defaultDiscountAccountId        String   @db.Uuid
  defaultExpenseAccountId         String   @db.Uuid
  defaultAccountsPayableAccountId String   @db.Uuid
  baseCurrency                    String   @db.Char(3)
  discountPostingMode             String   @default("CONTRA_REVENUE") @db.VarChar(32)
  createdAt                       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                       DateTime @updatedAt @db.Timestamptz(3)
  hotel                           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  defaultRoomRevenueAccount       Account  @relation("SettingsRoomRevenue", fields: [defaultRoomRevenueAccountId], references: [id], onDelete: Restrict)
  defaultGuestReceivableAccount   Account  @relation("SettingsGuestReceivable", fields: [defaultGuestReceivableAccountId], references: [id], onDelete: Restrict)
  defaultCashAccount              Account  @relation("SettingsCash", fields: [defaultCashAccountId], references: [id], onDelete: Restrict)
  defaultBankAccount              Account  @relation("SettingsBank", fields: [defaultBankAccountId], references: [id], onDelete: Restrict)
  defaultMobileMoneyAccount       Account  @relation("SettingsMobileMoney", fields: [defaultMobileMoneyAccountId], references: [id], onDelete: Restrict)
  defaultDepositAccount           Account  @relation("SettingsDeposit", fields: [defaultDepositAccountId], references: [id], onDelete: Restrict)
  defaultTaxPayableAccount        Account  @relation("SettingsTaxPayable", fields: [defaultTaxPayableAccountId], references: [id], onDelete: Restrict)
  defaultServiceRevenueAccount    Account  @relation("SettingsServiceRevenue", fields: [defaultServiceRevenueAccountId], references: [id], onDelete: Restrict)
  defaultDiscountAccount          Account  @relation("SettingsDiscount", fields: [defaultDiscountAccountId], references: [id], onDelete: Restrict)
  defaultExpenseAccount           Account  @relation("SettingsExpense", fields: [defaultExpenseAccountId], references: [id], onDelete: Restrict)
  defaultAccountsPayableAccount   Account  @relation("SettingsAccountsPayable", fields: [defaultAccountsPayableAccountId], references: [id], onDelete: Restrict)
}

model AccountingSequence {
  hotelId   String   @db.Uuid
  key       String   @db.VarChar(48)
  nextValue BigInt   @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Restrict)

  @@id([hotelId, key])
}
