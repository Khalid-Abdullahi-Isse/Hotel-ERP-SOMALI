NODE_ENV=development
PORT=3005
API_PREFIX=api
DATABASE_URL=postgresql://hotel_erp:change_me@localhost:5433/hotel_erp?schema=public
TEST_DATABASE_URL=postgresql://hotel_erp:change_me@localhost:5433/hotel_erp_test?schema=public
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
SWAGGER_ENABLED=true
JWT_ACCESS_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_ISSUER=somali-hotel-erp
JWT_AUDIENCE=somali-hotel-erp-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
AUTH_COOKIE_SECURE=false
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=30000
TRUST_PROXY_HOPS=0
# Required in production; generate at least 32 random characters.
MONITORING_TOKEN=
RATE_LIMIT_PER_MINUTE=5000
POSTGRES_DB=hotel_erp
POSTGRES_USER=hotel_erp
POSTGRES_PASSWORD=change_me
# Redis caching configuration. Use rediss:// when the provider requires TLS.
# Docker Compose exposes Redis on 6380 to avoid conflicts with other local services.
REDIS_URL=redis://127.0.0.1:6380
CACHE_TTL_MS=60000

# Guarded demo reset. DATABASE_URL must also target a database ending in _demo.
# DEMO_MODE=true
# DEMO_HOTEL_CODE=DEMO-MOG
# DEMO_RESET_ALLOWED_HOTEL_CODE=DEMO-MOG
# DEMO_MANAGER_USERNAME=demo.manager
# DEMO_MANAGER_EMAIL=demo.manager@example.com
# DEMO_MANAGER_FULL_NAME=Demo Hotel Manager
# DEMO_MANAGER_PASSWORD=replace_with_a_demo_password_of_at_least_12_characters

# Production only: use independent random values and URL-encode the URL password.
# APP_POSTGRES_PASSWORD=replace_with_a_random_secret_of_at_least_24_characters
# BACKUP_POSTGRES_PASSWORD=replace_with_another_random_secret
# APP_DATABASE_URL=postgresql://hotel_erp_app:url_encoded_password@postgres:5432/hotel_erp?schema=public

# Required only while running: npm run bootstrap:admin
# BOOTSTRAP_HOTEL_CODE=MOG-001
# BOOTSTRAP_HOTEL_NAME=Example Hotel
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_FULL_NAME=Hotel Administrator
# BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_unique_password
