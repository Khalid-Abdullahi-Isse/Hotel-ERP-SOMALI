{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": ".spec.ts$",
  "testPathIgnorePatterns": ["\\.e2e-spec\\.ts$"],
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "useESM": false,
        "tsconfig": {
          "module": "CommonJS",
          "moduleResolution": "Node",
          "esModuleInterop": true,
          "isolatedModules": true
        }
      }
    ]
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "testEnvironment": "node"
}
